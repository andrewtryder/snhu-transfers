# PostgreSQL connection. Local migration/bootstrap should use a direct Neon connection.
# Vercel Production uses the integration-provided pooled connection.
POSTGRES_URL=

# Required while the optional Vercel cron remains enabled.
CRON_SECRET=

# Used after successful external synchronization to invalidate cached data.
REVALIDATE_SECRET=

# Optional public configuration.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_COURSES_URL=

# Optional monitoring.
HONEYBADGER_API_KEY=
NEXT_PUBLIC_HONEYBADGER_API_KEY=
