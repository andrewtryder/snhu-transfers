# PostgreSQL connection URL for runtime queries, migration, bootstrap, and sync.
POSTGRES_URL=

# Optional verified TLS CA for PostgreSQL (local path or inline PEM on Vercel).
POSTGRES_CA_CERT=

# Used after successful external synchronization to invalidate cached data.
REVALIDATE_SECRET=

# Optional public configuration.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_COURSES_URL=

# Optional monitoring.
HONEYBADGER_API_KEY=
NEXT_PUBLIC_HONEYBADGER_API_KEY=
